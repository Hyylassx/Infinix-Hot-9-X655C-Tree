# Android fstab file for TWRP - Infinix X655C

# Dynamic Partitions (Removed first_stage_mount to prevent early property lockout)
system      /system      ext4    ro      wait,logical
vendor      /vendor      ext4    ro      wait,logical
product     /product     ext4    ro      wait,logical

# Core Partitions
/dev/block/by-name/boot         /boot         emmc    defaults    defaults
/dev/block/by-name/recovery     /recovery     emmc    defaults    defaults
/dev/block/by-name/cache        /cache        ext4    noatime,nosuid,nodev,discard    wait,check,formattable
/dev/block/by-name/metadata     /metadata     ext4    noatime,nosuid,nodev,discard    wait,formattable
/dev/block/by-name/super        /super        emmc    defaults    defaults

# Data (Stripped latemount and explicit encryption calls to stop SIGABRT)
/dev/block/by-name/userdata     /data         f2fs    noatime,nosuid,nodev,discard    wait,check,formattable

# Vendor / NVRAM
/dev/block/by-name/md_udc       /md_udc                     ext4    noatime,nosuid,nodev,discard    wait,formattable
/dev/block/by-name/tranfs       /tranfs                     ext4    noatime,nosuid,nodev,discard    wait,check,formattable,nofail
/dev/block/by-name/protect1     /mnt/vendor/protect_f       ext4    noatime,nosuid,nodev            wait,check,formattable
/dev/block/by-name/protect2     /mnt/vendor/protect_s       ext4    noatime,nosuid,nodev            wait,check,formattable
/dev/block/by-name/nvdata       /mnt/vendor/nvdata          ext4    noatime,nosuid,nodev            wait,check,formattable
/dev/block/by-name/nvcfg        /mnt/vendor/nvcfg           ext4    noatime,nosuid,nodev            wait,check,formattable
/dev/block/by-name/persist      /mnt/vendor/persist         ext4    noatime,nosuid,nodev            wait,check,formattable

# Firmware / Security
/dev/block/by-name/frp            /frp             emmc    defaults    defaults
/dev/block/by-name/nvram          /nvram           emmc    defaults    defaults
/dev/block/by-name/proinfo        /proinfo         emmc    defaults    defaults
/dev/block/by-name/lk             /bootloader      emmc    defaults    defaults
/dev/block/by-name/lk2            /bootloader2     emmc    defaults    defaults
/dev/block/by-name/para           /misc            emmc    defaults    defaults
/dev/block/by-name/logo           /logo            emmc    defaults    defaults
/dev/block/by-name/dtbo           /dtbo            emmc    defaults    defaults
/dev/block/by-name/vbmeta         /vbmeta          emmc    defaults    defaults
/dev/block/by-name/vbmeta_system  /vbmeta_system   emmc    defaults    nofail
/dev/block/by-name/vbmeta_vendor  /vbmeta_vendor   emmc    defaults    nofail

# External Storage (Simplified syntax to avoid vold flags errors)
/dev/block/mmcblk1p1              /external_sd     auto    defaults    defaults
/dev/block/sda1                   /usb_otg         auto    defaults    defaults
