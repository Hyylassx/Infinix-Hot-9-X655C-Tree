# Import vold decrypt triggers
import /init.recovery.vold_decrypt.rc

service teei_daemon /vendor/bin/teei_daemon \
    -r 020b0000000000000000000000000000 \
    -r 020f0000000000000000000000000000 \
    -r 06090000000000000000000000000000 \
    -r 05120000000000000000000000000000 \
    -r 40188311faf343488db888ad39496f9a \
    -r 07060000000000000000000000007169 \
    -r 9073f03a9618383bb1856eb3f990babd \
    -r 08050000000000000000000000003419 \
    -r 5020170115e016302017012521300000 \
    -r 0f5eed3c3b5a47afacca69a84bf0efad \
    -r 07407000000000000000000000000000 \
    -r 05160000000000000000000000000000 \
    -r 91dba524a6e24909acc48abd7163121a \
    -r 08030000000000000000000000000000 \
    -r 85f630e0f0964c5fa2cc268ce04e3da3 \
    -r 98fb95bcb4bf42d26473eae48690d7ea \
    -r 7b66512021214487ba710a51d7ea78fe \
    -r 09010000000000000000000000000000
    class core
    user system
    group system
    disabled
    seclabel u:r:teei_daemon:s0

service teei_capi_2_0 /vendor/bin/hw/vendor.microtrust.hardware.capi@2.0-service
    class core
    user system
    group system
    disabled
    seclabel u:r:teei_daemon:s0

service bp_kmsetkey_ca /vendor/bin/bp_kmsetkey_ca
    class core
    user system
    group system
    disabled
    seclabel u:r:teei_daemon:s0

service keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    user system
    group system drmrpc
    disabled
    seclabel u:r:hal_keymaster_default:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user system
    group system
    disabled
    seclabel u:r:hal_gatekeeper_default:s0

# ============================================
# ALL services start on boot (recovery-safe trigger)
# ============================================
on fs
    start hwservicemanager

# KITA MATIKAN DULU SEMENTARA BIAR TIDAK CRASH/LOOPING
# on boot
#     start teei_daemon
#     start teei_capi_2_0
#     start bp_kmsetkey_ca
#     start keymaster-4-0-beanpod
#     start gatekeeper-1-0

# ============================================
# Shutdown
# ============================================
on property:twrp.decrypt.done=true
    stop gatekeeper-1-0
    stop keymaster-4-0-beanpod
    stop teei_capi_2_0
    stop bp_kmsetkey_ca
    stop teei_daemon
