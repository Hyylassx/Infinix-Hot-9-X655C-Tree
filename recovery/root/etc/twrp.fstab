# twrp.flags - Tampilan GUI untuk Infinix Hot 9
/boot           emmc      /dev/block/by-name/boot           flags=display="Boot";backup=1;flashimg=1
/recovery       emmc      /dev/block/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1
/cache          ext4      /dev/block/by-name/cache          flags=display="Cache"
/metadata       ext4      /dev/block/by-name/metadata       flags=display="Metadata"
/voldmanaged    auto      /devices/platform/externdevice* flags=display="MicroSD";storage;wipeui;removable
/usbotg         auto      /devices/platform/mt_usb* flags=display="USB OTG";storage;wipeui;removable

# Backup kritis NVRAM/IMEI
/nvram          emmc      /dev/block/by-name/nvram          flags=display="NVRAM";backup=1;subpartitionof=/nvdata
/nvdata         ext4      /dev/block/by-name/nvdata         flags=display="NVData";backup=1
/nvcfg          ext4      /dev/block/by-name/nvcfg          flags=display="NVCfg";backup=1
/persistent     emmc      /dev/block/by-name/frp            flags=display="FRP";backup=1

# Firmware images backup
/logo           emmc      /dev/block/by-name/logo           flags=display="Logo";backup=1;flashimg=1
/dtbo           emmc      /dev/block/by-name/dtbo           flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc      /dev/block/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1
